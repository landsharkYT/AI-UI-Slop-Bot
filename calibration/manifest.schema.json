{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ui-slop.dev/schema/calibration-case/1",
  "title": "AI UI Slop Calibration Case",
  "type": "object",
  "required": [
    "caseId",
    "set",
    "repositoryRevision",
    "designFamily",
    "pageArchetypes",
    "renderedReferences",
    "labels",
    "reviewers"
  ],
  "properties": {
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "set": { "enum": ["calibration", "holdout"] },
    "repositoryRevision": { "type": "string", "minLength": 7 },
    "designFamily": { "type": "string", "minLength": 1 },
    "pageArchetypes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "renderedReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "owner", "judgment", "rationale"],
        "properties": {
          "ruleId": { "type": "string" },
          "owner": { "type": "string" },
          "judgment": { "enum": ["accept", "reject", "ambiguous", "missed"] },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewerId", "judgments"],
        "properties": {
          "reviewerId": { "type": "string" },
          "judgments": { "type": "array" },
          "abstained": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
