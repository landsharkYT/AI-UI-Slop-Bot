{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ui-slop.dev/schema/report/7",
  "title": "AI UI Slop Canonical Report",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "toolVersion",
    "rulePackVersion",
    "summary",
    "scopes"
  ],
  "properties": {
    "artifactType": { "const": "ai-ui-slop.canonical-report" },
    "schemaVersion": { "const": "7" },
    "toolVersion": { "type": "string" },
    "rulePackVersion": { "type": "string" },
    "fingerprintAlgorithmVersion": { "type": "string" },
    "evidenceDigestAlgorithmVersion": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["outcome", "scopeCount", "findingCount"]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "root",
          "status",
          "policyFingerprint",
          "policySource",
          "coverage",
          "routes",
          "graph",
          "styleAdapter",
          "componentProfiles",
          "findings",
          "findingImpacts",
          "repositoryProfile",
          "diagnostics",
          "resourceUsage"
        ],
        "properties": {
          "resourceUsage": {
            "type": "object",
            "required": ["sourceBytesRead", "parserArenaPeakBytes", "peakAccountedAnalysisBytes", "astNodesSeen", "diagnosticsEmitted"],
            "properties": {
              "sourceBytesRead": { "type": "integer", "minimum": 0 },
              "parserArenaPeakBytes": { "type": "integer", "minimum": 0 },
              "peakAccountedAnalysisBytes": { "type": "integer", "minimum": 0 },
              "astNodesSeen": { "type": "integer", "minimum": 0 },
              "diagnosticsEmitted": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "findingImpacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["findingFingerprint", "usageSites"],
              "properties": {
                "findingFingerprint": { "type": "string" },
                "usageSites": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "componentProfiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "owner", "score", "band", "scoredReachableState", "contributions", "findingFingerprints"],
              "properties": {
                "path": { "type": "string" },
                "owner": { "type": "string" },
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "band": { "type": "string" },
                "scoredReachableState": { "type": ["string", "null"] },
                "contributions": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/scoreContribution" }
                },
                "findingFingerprints": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "repositoryProfile": {
            "type": "object",
            "required": ["score", "band", "interpretationStatus", "contributions", "componentCount", "affectedComponentCount", "recurringPatterns"],
            "properties": {
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "band": { "type": "string" },
              "interpretationStatus": { "enum": ["qualified", "coverage_limited"] },
              "contributions": {
                "type": "array",
                "items": { "$ref": "#/$defs/scoreContribution" }
              },
              "componentCount": { "type": "integer", "minimum": 0 },
              "affectedComponentCount": { "type": "integer", "minimum": 0 },
              "recurringPatterns": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              }
            },
            "additionalProperties": false
          },
          "styleAdapter": {
            "type": "object",
            "required": [
              "tailwindVersion",
              "detectionSource",
              "sources",
              "unresolved",
              "configurationImportEdges",
              "configurationBytes",
              "resolvedConfigurationValues",
              "semanticUtilitiesResolved",
              "customVariants"
            ],
            "properties": {
              "tailwindVersion": { "type": ["string", "null"] },
              "detectionSource": { "type": ["string", "null"] },
              "sources": {
                "type": "array",
                "items": { "type": "string" }
              },
              "unresolved": {
                "type": "array",
                "items": { "type": "string" }
              },
              "configurationImportEdges": { "type": "integer", "minimum": 0 },
              "configurationBytes": { "type": "integer", "minimum": 0 },
              "resolvedConfigurationValues": { "type": "integer", "minimum": 0 },
              "semanticUtilitiesResolved": { "type": "integer", "minimum": 0 },
              "customVariants": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "$defs": {
    "scoreContribution": {
      "type": "object",
      "required": ["id", "points", "cap", "evidenceCount", "explanation"],
      "properties": {
        "id": { "type": "string" },
        "points": { "type": "integer", "minimum": 0, "maximum": 100 },
        "cap": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
