{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ui-slop.dev/schema/report/4",
  "title": "AI UI Slop Canonical Report",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "toolVersion",
    "rulePackVersion",
    "summary",
    "scopes"
  ],
  "properties": {
    "artifactType": { "const": "ai-ui-slop.canonical-report" },
    "schemaVersion": { "const": "4" },
    "toolVersion": { "type": "string" },
    "rulePackVersion": { "type": "string" },
    "fingerprintAlgorithmVersion": { "type": "string" },
    "evidenceDigestAlgorithmVersion": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["outcome", "scopeCount", "findingCount"]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "root",
          "status",
          "policyFingerprint",
          "policySource",
          "coverage",
          "routes",
          "graph",
          "styleAdapter",
          "componentProfiles",
          "findings",
          "repositoryProfile",
          "diagnostics"
        ],
        "properties": {
          "styleAdapter": {
            "type": "object",
            "required": [
              "tailwindVersion",
              "detectionSource",
              "sources",
              "unresolved",
              "configurationImportEdges",
              "configurationBytes",
              "resolvedConfigurationValues",
              "semanticUtilitiesResolved",
              "customVariants"
            ],
            "properties": {
              "tailwindVersion": { "type": ["string", "null"] },
              "detectionSource": { "type": ["string", "null"] },
              "sources": {
                "type": "array",
                "items": { "type": "string" }
              },
              "unresolved": {
                "type": "array",
                "items": { "type": "string" }
              },
              "configurationImportEdges": { "type": "integer", "minimum": 0 },
              "configurationBytes": { "type": "integer", "minimum": 0 },
              "resolvedConfigurationValues": { "type": "integer", "minimum": 0 },
              "semanticUtilitiesResolved": { "type": "integer", "minimum": 0 },
              "customVariants": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}
